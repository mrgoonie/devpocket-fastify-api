FROM node:20-alpine

# Install build tools and Python for node-gyp
RUN apk add --no-cache python3 make g++ py3-distutils

# Install pnpm
RUN npm install -g pnpm

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml* ./

# Install dependencies
RUN pnpm install

# Copy source code
COPY . .

# Generate Prisma client
RUN pnpm run db:generate

# Expose port
EXPOSE 3000

# Start development server
CMD ["pnpm", "run", "dev"]