import { z } from 'zod';
import { AuthType, SessionStatus } from '@prisma/client';

// SSH Profile Schemas
export const CreateSshProfileSchema = z.object({
  name: z.string().min(1).max(100).trim(),
  host: z.string().min(1).max(255).trim(),
  port: z.number().min(1).max(65535).default(22),
