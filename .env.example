# DevPocket Backend Environment Configuration
# Copy this file to .env and update the values

# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL="postgresql://devpocket:devpocket@localhost:5432/devpocket-fastify-api-dev?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-change-this-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Encryption for SSH keys
ENCRYPTION_KEY="your-encryption-key-for-ssh-keys-change-this-min-32-chars"

# Email Configuration (Resend)
RESEND_API_KEY=""
FROM_EMAIL="noreply@devpocket.com"

# RevenueCat Webhook
REVENUECAT_WEBHOOK_SECRET=""

# Frontend URL
FRONTEND_URL="https://devpocket.com"

# Docker Database Configuration (for docker-compose)
POSTGRES_USER=devpocket
POSTGRES_PASSWORD=devpocket
POSTGRES_DB=devpocket-fastify-api-dev